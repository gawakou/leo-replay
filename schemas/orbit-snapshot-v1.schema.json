{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/leo-replay/orbit-snapshot-v1.schema.json",
  "title": "LEO Replay Orbit Snapshot Manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_type",
    "generated_at_utc",
    "retrieved_at_utc",
    "generator",
    "provider",
    "request_fingerprint",
    "request_file",
    "format",
    "combined_body_file",
    "combined_sha256",
    "record_count",
    "part_count",
    "parts"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manifest_type": {"const": "orbit_snapshot"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "retrieved_at_utc": {"type": "string", "format": "date-time"},
    "generator": {"type": "string"},
    "provider": {"type": "string", "minLength": 1},
    "request_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_file": {"type": "string"},
    "format": {"enum": ["json", "csv", "tle"]},
    "combined_body_file": {"type": "string"},
    "combined_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record_count": {"type": "integer", "minimum": 1},
    "part_count": {"type": "integer", "minimum": 1},
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "index",
          "status",
          "source_uri",
          "body_file",
          "headers_file",
          "sha256",
          "bytes",
          "record_count"
        ],
        "properties": {
          "index": {"type": "integer", "minimum": 1},
          "status": {"type": "integer"},
          "source_uri": {"type": "string"},
          "body_file": {"type": "string"},
          "headers_file": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "record_count": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": true
      }
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": true
}
