{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/leo-replay/visualization-bundle-v1.schema.json",
  "title": "LEO Replay Synchronized Visualization Bundle v1",
  "type": "object",
  "required": [
    "schema_version",
    "visualization_type",
    "generated_at_utc",
    "generator",
    "title",
    "semantics",
    "site",
    "source",
    "timeline",
    "events",
    "frames",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "visualization_type": { "const": "orbit_communication_timeline" },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "generator": { "type": "string" },
    "title": { "type": "string" },
    "semantics": { "type": "object" },
    "site": {
      "type": "object",
      "required": ["site_id", "name", "latitude_deg", "longitude_deg", "elevation_m"],
      "properties": {
        "site_id": { "type": "string" },
        "name": { "type": "string" },
        "latitude_deg": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude_deg": { "type": "number", "minimum": -180, "maximum": 180 },
        "elevation_m": { "type": "number" }
      },
      "additionalProperties": true
    },
    "source": { "type": "object" },
    "timeline": {
      "type": "object",
      "required": ["start_utc", "end_utc", "frame_count", "profile_start_utc"],
      "properties": {
        "start_utc": { "type": "string", "format": "date-time" },
        "end_utc": { "type": "string", "format": "date-time" },
        "frame_count": { "type": "integer", "minimum": 1 },
        "profile_start_utc": { "type": "string", "format": "date-time" }
      }
    },
    "events": { "type": "array" },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["timestamp_utc", "elapsed_sec", "communication", "events", "satellites", "summary"],
        "properties": {
          "timestamp_utc": { "type": "string", "format": "date-time" },
          "elapsed_sec": { "type": "number" },
          "communication": { "type": ["object", "null"] },
          "events": { "type": "array" },
          "satellites": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["norad_cat_id", "object_name", "causal", "retrospective", "position_delta_km", "flags", "visibility"],
              "properties": {
                "norad_cat_id": { "type": "string" },
                "object_name": { "type": "string" },
                "causal": { "$ref": "#/$defs/positionOrNull" },
                "retrospective": { "$ref": "#/$defs/positionOrNull" },
                "position_delta_km": { "type": ["number", "null"] },
                "flags": { "type": "array", "items": { "type": "string" } },
                "visibility": { "type": ["object", "null"] }
              }
            }
          },
          "summary": { "type": "object" }
        }
      }
    },
    "summary": { "type": "object" },
    "map_bounds": { "type": "object" }
  },
  "$defs": {
    "positionOrNull": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["latitude_deg", "longitude_deg", "height_km", "stale_element", "propagation_error"],
          "properties": {
            "latitude_deg": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude_deg": { "type": "number", "minimum": -180, "maximum": 180 },
            "height_km": { "type": ["number", "null"] },
            "stale_element": { "type": "boolean" },
            "propagation_error": { "type": "string" }
          }
        }
      ]
    }
  },
  "additionalProperties": true
}
